      },
      "offset": {
        "type": "integer",
        "description": "分页偏移量，默认0"
      },
      "limit": {
        "type": "integer",
        "description": "每页数量，默认20"
      },
      "sortName": {
        "type": "string",
        "description": "排序字段"
      },
      "sortOrder": {
        "type": "string",
        "description": "排序方向",
        "enum": [
          "asc",
          "desc"
        ]
      }
    },
    "required": [],
    "memberActions": [],
    "actions": [
      "list",
      "get",
      "show_log"
    ],
    "readOnly": true,
    "destructive": false
  },
  "cert_order_manage": {
