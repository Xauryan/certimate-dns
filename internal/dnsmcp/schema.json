  "cert_order_query": {
    "title": "查询SSL证书订单",
    "properties": {
      "id": {
        "type": [
          "string",
          "integer"
        ],
        "description": "证书订单ID（get 必填；list 可按ID筛选）"
      },
      "domain": {
        "type": "string",
        "description": "list：按绑定域名搜索"
      },
